{
  "always_run_in_app" : false,
  "icon" : {
    "color" : "gray",
    "glyph" : "magic"
  },
  "name" : "250727_countdown",
  "script" : "\/\/ Countdown Widget (Scriptable) — boundaries: 10d \/ 100h \/ 24:00 \/ 100m\n\/\/ パラメータに ISO日時（例: 2025-09-14T20:05:00+09:00）。未設定は DEFAULT_TARGET。\n\nconst DEFAULT_TARGET = \"2026-08-09T09:00:00+09:00\";\n\n\/\/ ---- 境目（ms） ----\nconst TEN_DAYS_MS        = 12 * 24 * 3600 * 1000;  \/\/ 10 day\nconst HUNDRED_HOURS_MS   = 120 * 3600 * 1000;      \/\/ 100 h\nconst TWENTY4_HOURS_MS   = 24 * 3600 * 1000;       \/\/ 24:00\nconst HUNDRED_MINUTES_MS = 120 * 60 * 1000;        \/\/ 100 m\n\n\/\/ 微小マージン（境界直後の“増えた感”やチラつき緩和）\nconst EPS_MS = 30 * 1000;\n\n\/\/ ---- 入力 ----\nconst paramRaw = (args.widgetParameter || DEFAULT_TARGET).trim();\nconst parsed = new Date(paramRaw);\nconst TARGET = isNaN(parsed.getTime()) ? new Date(DEFAULT_TARGET) : parsed;\n\nconst now = new Date();\nlet ms = TARGET - now;\n\n\/\/ ---- モード判定 ----\n\/\/ week(>10d) → day(<=10d … >100h) → hour(<=100h … >24h) → clock(<=24h … >=100m) → min(<100m)\nfunction pickMode(ms) {\n  if (ms <= 0) return \"done\";\n  if (ms >  TEN_DAYS_MS + EPS_MS)      return \"week\";   \/\/ >10d は週（2桁）\n  if (ms >  HUNDRED_HOURS_MS + EPS_MS) return \"day\";    \/\/ 10d以下〜100h超は日（2桁）\n  if (ms >  TWENTY4_HOURS_MS + EPS_MS) return \"hour\";   \/\/ 100h以下〜24h超は時間（1桁）\n  if (ms >= HUNDRED_MINUTES_MS)        return \"clock\";  \/\/ 24h以下〜100m以上は時計\n  return \"min\";\n}\n\nconst mode = pickMode(ms);\n\n\/\/ ---- フォーマッタ ----\nconst MS_PER_DAY = 86400000;\n\nfunction fmtWeek(ms) { return (ms \/ (7 * MS_PER_DAY)).toFixed(2); } \/\/ 週\nfunction fmtDay(ms)  { return (ms \/ MS_PER_DAY).toFixed(2); }       \/\/ 日（2桁）\nfunction fmtHour(ms) { return (ms \/ 3600000).toFixed(1); }          \/\/ 時（1桁）\nfunction splitHM(ms) {\n  const totalSec = Math.max(0, Math.floor(ms \/ 1000));\n  const h = Math.floor(totalSec \/ 3600);\n  const m = Math.floor((totalSec % 3600) \/ 60);\n  return { h, m };\n}\nfunction fmtClock(ms) {\n  const { h, m } = splitHM(ms);\n  return { h, m, hhmm: `${String(h)}:${String(m).padStart(2, \"0\")}` };\n}\nfunction fmtMin(ms) {\n  return Math.max(0, Math.floor(ms \/ 60000));\n}\n\n\/\/ ---- ウィジェット種別 ----\nconst family = config.runsInAccessoryWidget ? config.widgetFamily : \"accessoryRectangular\";\nconst widget = new ListWidget();\n\n\/\/ ---- 円形描画（中央寄せを厳密化：左右Spacer法） ----\nfunction drawCircular() {\n  widget.setPadding(0, 0, 0, 0);\n\n  \/\/ 1行センタリングのヘルパ\n  function addCenteredLine(text, font, opacity = 1.0) {\n    const row = widget.addStack();\n    row.addSpacer();\n    const t = row.addText(text);\n    t.font = font;\n    t.textOpacity = opacity;\n    row.addSpacer();\n  }\n\n  if (mode === \"done\") {\n    addCenteredLine(\"🎉\", Font.boldSystemFont(16));\n    return;\n  }\n\n  \/\/ 2行レイアウトが基本（数値 \/ 単位 or 分）\n  if (mode === \"week\") {\n    addCenteredLine(fmtWeek(ms), Font.boldSystemFont(15));\n    addCenteredLine(\"wk\",        Font.mediumSystemFont(12), 0.9);\n  } else if (mode === \"day\") {\n    addCenteredLine(fmtDay(ms),  Font.boldSystemFont(15));\n    addCenteredLine(\"d\",         Font.mediumSystemFont(12), 0.9);\n  } else if (mode === \"hour\") {\n    \/\/ 100.0h からのカウントダウン（1桁小数）\n    addCenteredLine(fmtHour(ms), Font.boldSystemFont(15));\n    addCenteredLine(\"h\",         Font.mediumSystemFont(12), 0.9);\n  } else if (mode === \"clock\") {\n    \/\/ 分が動く視覚（上：h \/ 下：m）\n    const { h, m } = splitHM(ms);\n    addCenteredLine(`${h}h`,     Font.boldSystemFont(15));\n    addCenteredLine(`${m}m`,     Font.mediumSystemFont(12), 0.9);\n  } else if (mode === \"min\") {\n    \/\/ 分だけ大きく\n    addCenteredLine(`${fmtMin(ms)}m`, Font.boldSystemFont(16));\n  }\n}\n\n\/\/ ---- 横長描画 ----\nfunction drawRect() {\n  widget.setPadding(0, 0, 0, 0);\n\n  \/\/ タイトル\n  const titleRow = widget.addStack();\n  titleRow.addSpacer();\n  const title = titleRow.addText(mode === \"done\" ? \"いぇい\" : \"🐵\");\n  title.font = Font.mediumSystemFont(20);\n  title.textOpacity = 0.9;\n  titleRow.addSpacer();\n\n  const bodyRow = widget.addStack();\n  bodyRow.addSpacer();\n\n  let bodyText = \"\";\n  if (mode === \"done\") {\n    bodyText = \"00:00\";\n  } else if (mode === \"week\") {\n    bodyText = `${fmtWeek(ms)} wk`;\n  } else if (mode === \"day\") {\n    bodyText = `${fmtDay(ms)} day`;\n  } else if (mode === \"hour\") {\n    bodyText = `${fmtHour(ms)} h`;\n  } else if (mode === \"clock\") {\n    bodyText = fmtClock(ms).hhmm; \/\/ 例: 23:58\n  } else { \/\/ min\n    bodyText = `${fmtMin(ms)} m`;\n  }\n\n  const body = bodyRow.addText(bodyText);\n  body.font = Font.mediumSystemFont(\n    mode === \"clock\" ? 44 :\n    mode === \"min\"   ? 48 : 48\n  );\n  bodyRow.addSpacer();\n}\n\n\/\/ ---- 実行 ----\nif (family === \"accessoryCircular\") {\n  drawCircular();\n} else {\n  drawRect();\n}\n\nScript.setWidget(widget);\nScript.complete();",
  "share_sheet_inputs" : [

  ]
}